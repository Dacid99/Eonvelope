#. Translators: E∘nvelope is the brand name. The ∘ is the ring operator U+2218. ReadTheDocs is a brand name.
#: src/config/settings.py:803
msgid "Read the E∘nvelope Documentation on ReadTheDocs"
msgstr "Lisez la documentation d'E∘nvelope sur ReadTheDocs"

#: src/config/settings.py:940
msgid "Default page size for paginated API response data"
msgstr "Taille de la page par défaut pour les données de réponse API paginées"

#: src/config/settings.py:945
msgid "Maximum page size for paginated API response data"
msgstr "Taille max. de la page pour les données de réponse API paginées"

#: src/config/settings.py:950
msgid "Default page size for pagination in the webapp."
msgstr "Taille par défaut de la page pour la pagination dans l'appli Web."

#: src/config/settings.py:956
msgid ""
"Page size options for pagination in the webapp. Should contain the "
"WEB_DEFAULT_PAGE_SIZE value."
msgstr ""
"Options de la taille de la page pour la pagination dans l'appli Web. Devrait "
"contenir la valeur WEB_DEFAULT_PAGE_SIZE."

#: src/config/settings.py:963
msgid ""
"Maximum datasize for a thumbnail in the webapp. Thumbnails larger than this "
"will not be loaded."
msgstr ""
"Taille maximale des données pour une miniature dans l'appli Web. Les "
"miniatures plus grandes que ceci ne seront pas chargées."

#: src/config/settings.py:969
msgid "Whether to show tooltips in the web interface."
msgstr "Afficher les infobulles dans l'interface web."

#: src/config/settings.py:974
msgid "Maximum numbers of files in one storage unit."
msgstr "Nombre maximal de fichiers dans une seule unité de stockage."

#: src/config/settings.py:979
msgid "Whether or not to ignore emails and mailboxes that have a spam flag"
msgstr ""
"S'il faut ou non ignorer les courriels et les boîtes aux lettres marqués "
"comme indésirables"

#: src/config/settings.py:985
msgid ""
"Regex pattern (case-insensitive) for mailbox names that are ignored when "
"looking up mailboxes in an account."
msgstr ""
"Modèle regex (indifférent à la casse) pour les noms de boîtes aux lettres "
"qui sont ignorés lors de la consultation des boîtes aux lettres dans un "
"compte."

#: src/config/settings.py:991
msgid "List of content types prefixes to not parse as files."
msgstr ""
"Liste des préfixes de types de contenu à ne pas analyser comme fichiers."

#: src/config/settings.py:997
msgid ""
"List of content types prefixes to not parse as files. Plain and HTML text is "
"always ignored as its the bodytext."
msgstr ""
"Liste des préfixes de types de contenu à ne pas analyser comme fichiers. Le "
"texte en clair et HTML est toujours ignoré puisque c'est son corps."

#: src/config/settings.py:1004
msgid ""
"Html template used to render emails to html. Uses the django template syntax "
"and has access to all fields of the email database table. Removing template "
"tag imports may result in 500 responses when requesting pages with email "
"thumbnails, so be careful."
msgstr ""
"Le modèle HTML utilisé pour afficher les courriels en .html utilise la "
"syntaxe du modèle django et a accès à tous les champs de la table de base de "
"données de courriel. Retirer les importations d'étiquettes de modèle peut "
"donner lieu à 500 réponses lorsque vous demandez des pages avec des "
"vignettes de courriels, alors soyez prudent·e."

#: src/config/settings.py:1011
msgid ""
"Css style used to render emails to html. Refer to HTML_TEMPLATE for context "
"on the classes."
msgstr ""
"Style CSS utilisé pour rendre les courriels en .html. Se référer à "
"HTML_TEMPLATE pour le contexte sur les classes."

#: src/config/settings.py:1017
msgid "Default mailbox setting whether to store mails as eml."
msgstr ""
"Paramètre par défaut de la boîte de réception pour le stockage des courriels "
"en tant que .eml."

#: src/config/settings.py:1022
msgid "Default mailbox setting whether to store attachments."
msgstr ""
"Paramètre par défaut de la boîte de réception pour stocker les pièces "
"jointes."

#: src/config/settings.py:1028
msgid ""
"Default number of periods between two runs of a standard routine for a INBOX "
"mailbox."
msgstr ""
"Nombre par défaut de périodes entre deux séries d'une routine standard pour "
"une boîte aux lettres de RÉCEPTION."

#: src/config/settings.py:1034
msgid "Default fetching criterion for a standard routine for a INBOX mailbox."
msgstr ""
"Critère de récupération par défaut pour une routine standard d'une boîte aux "
"lettres de RÉCEPTION."

#: src/config/settings.py:1040
msgid ""
"Default number of periods between two runs of a standard routine for a SENT "
"mailbox."
msgstr ""
"Nombre par défaut de périodes entre deux séries d'une routine standard pour "
"une boîte aux lettres d'ENVOI."

#: src/config/settings.py:1046
msgid "Default fetching criterion for a standard routine for a SENT mailbox."
msgstr ""
"Critère de récupération par défaut pour une routine standard d'une boîte aux "
"lettres d'ENVOI."

#: src/config/settings.py:1052
msgid ""
"Set this to True to allow new users to sign up themselves. This setting only "
"takes effect if the REGISTRATION_ENABLED environment setting is not 0."
msgstr ""
"Définir ceci comme Vrai pour permettre aux nouveaux utilisateurs de "
"s'inscrire. Ce paramètre ne prend effet que si le paramètre d'environnement "
"REGISTRATION_ENABLED n'est pas 0."

#: src/config/settings.py:1059
msgid ""
"Set this to True to tolerate connections involving an unverified SSL "
"certificate, e.g. a self-signed one."
msgstr ""
"Sélectionnez Vrai pour accepter les connexions impliquant un certificat SSL "
"non vérifié, par exemple un certificat auto signé."

#: src/config/settings.py:1066
msgid ""
"Emails are auto-deleted this number of days past their 'Received' timestamp. "
"A non-positive number disables auto-deletion."
msgstr ""
"Les courriels sont automatiquement supprimés ce nombre de jours après le "
"moment de leur réception. Un entier non positif désactive la suppression "
"automatique."

#: src/config/settings.py:1074
msgid "Server Configurations"
msgstr "Configuration du serveur"

