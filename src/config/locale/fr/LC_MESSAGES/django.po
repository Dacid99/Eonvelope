msgid "Processing Settings"
msgstr "Paramètres de traitement"

#: src/config/settings.py:1103
msgid "Storage Settings"
msgstr "Paramètres de stockage"

#: src/config/settings.py:1110
msgid "API Settings"
msgstr "Paramètres API"

